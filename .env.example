# Copy to .env for local development. Never commit real values.
# Production values live only in Railway environment variables.

NODE_ENV=development

# Postgres (Railway sets DATABASE_URL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fluentloop

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Kakao Login (optional until the Kakao developer app is registered)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Magic-link email via Resend (optional in development — links are logged to the console)
RESEND_API_KEY=
EMAIL_FROM=SpeakGround <onboarding@resend.dev>

# LLM. Evals use Groq. The daily generator can use the same key.
# Fast model for volume, strong model for judging.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Railway Bucket, S3-compatible (later in Phase 1). Values come from the bucket's Credentials tab.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=

# Error monitoring (optional)
SENTRY_DSN=
